    using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.AI;
using DarkVoid.Utils;

public class EnemyAI : MonoBehaviour
{

    [SerializeField] private State startingState;
    [SerializeField] private float roamingDistanceMax = 7f;
    [SerializeField] private float roamingDistanceMin = 3f;
    [SerializeField] private float roamingTimerMax = 2f;
    [SerializeField] private Transform player;
    [SerializeField] private float detectionRadius = 6f;
    [SerializeField] private float followSpeed = 3f;

    private NavMeshAgent navMeshAgent;
    private State state;
    private float roamingTime;
    private Vector3 roamPosition;
    private Vector3 startingPosition;
    private Rigidbody2D rb2d;

    private enum State
    {
        Idle,
        Roaming,
        Follow
    }

    private void Start()
    {
        startingPosition = transform.position;
        if (player == null)
        {
            var go = GameObject.FindGameObjectWithTag("Player");
            if (go != null) player = go.transform;
        }
    }

    private void Awake()
    {
        navMeshAgent = GetComponent<NavMeshAgent>();
        navMeshAgent.updateRotation = false;
        navMeshAgent.updateUpAxis = false;
        state = startingState;
        rb2d = GetComponent<Rigidbody2D>();
    }

    private void Update()
    {
        // переключение в режим Follow при приближении игрока
        if (player != null)
        {
            float dist = Vector2.Distance(transform.position, player.position);
            if (dist <= detectionRadius)
            {
                if (state != State.Follow)
                {
                    state = State.Follow;
                    if (navMeshAgent != null) navMeshAgent.isStopped = true;
                }
            }
            else
            {
                if (state == State.Follow)
                {
                    state = State.Roaming;
                    if (navMeshAgent != null) navMeshAgent.isStopped = false;
                    roamingTime = 0f; // сразу выбрать новую точку
                }
            }
        }

        switch (state)
        {
            default:
            case State.Idle:
                break;
            case State.Roaming:
                roamingTime -= Time.deltaTime;
                if (roamingTime < 0)
                {
                    Roaming();
                    roamingTime = roamingTimerMax;
                }
                break;
            case State.Follow:
                if (player == null) break;
                var dir = player.position - transform.position;
                var absX = Mathf.Abs(dir.x);
                var absY = Mathf.Abs(dir.y);
                Vector3 target;
                if (absX > absY)
                {
                    // follow horizontally only
                    target = new Vector3(player.position.x, transform.position.y, transform.position.z);
                }
                else
                {
                    // follow vertically only
                    target = new Vector3(transform.position.x, player.position.y, transform.position.z);
                }
                // движение вручную (Rigidbody2D если есть, иначе transform)
                if (rb2d != null)
                {
                    Vector2 newPos = Vector2.MoveTowards(rb2d.position, (Vector2)target, followSpeed * Time.deltaTime);
                    rb2d.MovePosition(newPos);
                }
                else
                {
                    transform.position = Vector3.MoveTowards(transform.position, target, followSpeed * Time.deltaTime);
                }
                break;
        }
    }

    private void Roaming()
    { 
        roamPosition = GetRoamingPosition();
        navMeshAgent.SetDestination(roamPosition);
    }

    private Vector3 GetRoamingPosition()
    { 
        return startingPosition + Utils.GetRandomDir() * UnityEngine.Random.Range(roamingDistanceMin, roamingDistanceMax);
    }
}